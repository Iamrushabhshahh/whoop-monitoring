          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT local_date, recovery FROM (SELECT r.local_date AS local_date, r.score_recovery_score AS recovery, c.score_strain AS strain, s.score_stage_summary_total_in_bed_time_hours - s.score_stage_summary_total_awake_time_hours AS sleep_h, r.score_hrv_rmssd_milli AS hrv, r.score_resting_heart_rate AS rhr, c.step_count AS steps FROM (SELECT * FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY record_id ORDER BY updated_at DESC) AS rn FROM \"whoop_recovery\") WHERE rn = 1 AND (deleted IS NULL OR deleted = false) AND score_state = 'SCORED') r LEFT JOIN (SELECT * FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY record_id ORDER BY updated_at DESC) AS rn FROM \"whoop_cycle\") WHERE rn = 1 AND (deleted IS NULL OR deleted = false) AND score_state = 'SCORED') c ON r.record_id = c.record_id LEFT JOIN (SELECT * FROM (SELECT *, ROW_NUMBER() OVER (PARTITION BY record_id ORDER BY updated_at DESC) AS rn FROM \"whoop_sleep\") WHERE rn = 1 AND (deleted IS NULL OR deleted = false) AND score_state = 'SCORED' AND nap = false) s ON r.sleep_id = s.record_id) ORDER BY local_date",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "whoop_recovery",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Day",
                    "alias": "local_date",
                    "column": "local_date",
                    "color": null,
                    "isDerived": false
