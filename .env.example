# Copy to .env and fill in. Never commit .env.

# --- WHOOP developer app (https://developer-dashboard.whoop.com) -------------
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
# Must match a redirect URL registered on the app.
WHOOP_REDIRECT_URI=http://localhost:8765/callback

# --- OpenObserve -------------------------------------------------------------
O2_URL=http://localhost:5080
# Used by docker compose; containers cannot reach the host via localhost.
O2_URL_FROM_DOCKER=http://host.docker.internal:5080
O2_ORG=default
O2_USER=
O2_PASSWORD=
O2_STREAM_PREFIX=whoop_

# --- Sync ---------------------------------------------------------------------
SYNC_INTERVAL_SECONDS=900
# Re-read this many hours behind the watermark (WHOOP scores sleep/recovery late).
SYNC_LOOKBACK_HOURS=72

# --- Security -----------------------------------------------------------------
# Optional Fernet key to encrypt data/tokens.json at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# --- Alerts -------------------------------------------------------------------
# Where OpenObserve posts alert notifications (Slack/Discord/any webhook).
# Empty = provision dashboards only. Private hosts need ZO_SKIP_SSRF_CHECKS=true on OpenObserve.
# Local default: the collector logs alerts it receives as `alert.received` in whoopmon_app.
ALERT_WEBHOOK_URL=http://host.docker.internal:8080/o2-alert

# --- Telemetry ----------------------------------------------------------------
LOG_LEVEL=INFO
# json (default, for machines) | console (for humans)
LOG_FORMAT=json
OTEL_ENABLED=true
ENVIRONMENT=local
